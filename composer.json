{
    "name": "glue-agency/akeneo-glue-backoffice",
    "description": "Reports an Akeneo PIM to the Glue Dashboard after each deploy",
    "keywords": [
        "akeneo",
        "glue",
        "backoffice"
    ],
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "composer-runtime-api": "^2.0",
        "symfony/config": "^4.4|^5.4|^6.4|^7.0",
        "symfony/console": "^4.4|^5.4|^6.4|^7.0",
        "symfony/dependency-injection": "^4.4|^5.4|^6.4|^7.0",
        "symfony/http-kernel": "^4.4|^5.4|^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "GlueAgency\\Backoffice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlueAgency\\Backoffice\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
